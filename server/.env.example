NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Local Docker Compose defaults from the root docker-compose.yml.
# Copy this file to .env and never commit real secrets.
DATABASE_URL=postgresql://brightloop:brightloop@localhost:5432/subscription_db?schema=public

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=brightloop_token

# SMTP Configuration (for password reset and billing emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM=Brightloop <noreply@brightloop.com>
SMTP_SECURE=false
