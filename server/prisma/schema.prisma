generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------
enum Role {
  ADMIN
  INTERNAL
  CUSTOMER
}

enum ProductType {
  SERVICE
  GOODS
  ADDON
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum AmountType {
  PERCENT
  FIXED
}

enum DiscountScope {
  PRODUCT
  SUBSCRIPTION
}

enum PaymentTerms {
  IMMEDIATE
  NET_7
  NET_15
  NET_30
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  ONLINE
}

// ---------- MEMBER 1: USERS & AUTH ----------
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  phone        String?
  company      String?
  address      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resetTokens        PasswordResetToken[]
  subscriptions      Subscription[]       @relation("CustomerSubscriptions")
  salesSubscriptions Subscription[]       @relation("SalespersonSubscriptions")
  invoices           Invoice[]
  paymentsRecorded   Payment[]
  subscriptionEvents SubscriptionEvent[]

  @@index([role])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- MEMBER 2: CATALOG ----------
model Product {
  id         Int         @id @default(autoincrement())
  name       String
  type       ProductType @default(SERVICE)
  salesPrice Decimal     @db.Decimal(12, 2)
  costPrice  Decimal     @default(0) @db.Decimal(12, 2)
  notes      String?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  variants          ProductVariant[]
  taxes             Tax[]                   @relation("ProductTaxes")
  discounts         Discount[]              @relation("DiscountProducts")
  subscriptionLines SubscriptionLine[]
  templateLines     QuotationTemplateLine[]
  invoiceLines      InvoiceLine[]
}

model ProductVariant {
  id         Int     @id @default(autoincrement())
  productId  Int
  attribute  String // e.g. "Brand"
  value      String // e.g. "Odoo"
  extraPrice Decimal @default(0) @db.Decimal(12, 2) // e.g. 560
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  subscriptionLines SubscriptionLine[]
  templateLines     QuotationTemplateLine[]

  @@unique([productId, attribute, value])
}

model Plan {
  id            Int           @id @default(autoincrement())
  name          String
  price         Decimal       @default(0) @db.Decimal(12, 2)
  billingPeriod BillingPeriod
  minQuantity   Int           @default(1)
  startDate     DateTime
  endDate       DateTime?
  autoClose     Boolean       @default(false)
  closable      Boolean       @default(true)
  pausable      Boolean       @default(true)
  renewable     Boolean       @default(true)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())

  subscriptions Subscription[]
  templates     QuotationTemplate[]
}

model Tax {
  id       Int        @id @default(autoincrement())
  name     String // "GST 18%"
  type     AmountType @default(PERCENT)
  amount   Decimal    @db.Decimal(12, 2)
  isActive Boolean    @default(true)

  products Product[]          @relation("ProductTaxes")
  lines    SubscriptionLine[] @relation("LineTaxes")
}

model Discount {
  id          Int           @id @default(autoincrement())
  name        String
  code        String?       @unique
  type        AmountType
  value       Decimal       @db.Decimal(12, 2)
  scope       DiscountScope @default(PRODUCT)
  minPurchase Decimal?      @db.Decimal(12, 2)
  minQuantity Int?
  startDate   DateTime
  endDate     DateTime?
  usageLimit  Int?
  usedCount   Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())

  products      Product[]      @relation("DiscountProducts")
  subscriptions Subscription[]
  invoices      Invoice[]
}

// ---------- MEMBER 3: SALES & SUBSCRIPTIONS ----------
model QuotationTemplate {
  id           Int      @id @default(autoincrement())
  name         String
  validityDays Int      @default(30)
  planId       Int
  notes        String?
  createdAt    DateTime @default(now())

  plan          Plan                    @relation(fields: [planId], references: [id])
  lines         QuotationTemplateLine[]
  subscriptions Subscription[]
}

model QuotationTemplateLine {
  id         Int  @id @default(autoincrement())
  templateId Int
  productId  Int
  variantId  Int?
  quantity   Int  @default(1)

  template QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id])
  variant  ProductVariant?   @relation(fields: [variantId], references: [id])
}

model Subscription {
  id              Int                @id @default(autoincrement())
  number          String?            @unique // SUB-00001 (set right after insert)
  customerId      Int
  planId          Int
  templateId      Int?
  discountId      Int? // whole-subscription discount
  salespersonId   Int?
  status          SubscriptionStatus @default(DRAFT)
  startDate       DateTime
  expiryDate      DateTime?
  quoteValidUntil DateTime?
  paymentTerms    PaymentTerms       @default(IMMEDIATE)
  nextInvoiceDate DateTime?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  customer    User                @relation("CustomerSubscriptions", fields: [customerId], references: [id])
  salesperson User?               @relation("SalespersonSubscriptions", fields: [salespersonId], references: [id])
  plan        Plan                @relation(fields: [planId], references: [id])
  template    QuotationTemplate?  @relation(fields: [templateId], references: [id])
  discount    Discount?           @relation(fields: [discountId], references: [id])
  lines       SubscriptionLine[]
  invoices    Invoice[]
  events      SubscriptionEvent[]

  @@index([status])
  @@index([customerId])
  @@index([status, nextInvoiceDate])
}

model SubscriptionLine {
  id             Int     @id @default(autoincrement())
  subscriptionId Int
  productId      Int
  variantId      Int?
  description    String?
  quantity       Int     @default(1)
  unitPrice      Decimal @db.Decimal(12, 2)
  amount         Decimal @db.Decimal(12, 2) // quantity * unitPrice, before tax

  subscription Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  taxes        Tax[]           @relation("LineTaxes")
}

model SubscriptionEvent {
  id             Int                 @id @default(autoincrement())
  subscriptionId Int
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus
  note           String?
  userId         Int?
  createdAt      DateTime            @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])
}

// ---------- MEMBER 4: BILLING & PAYMENTS ----------
model Invoice {
  id             Int           @id @default(autoincrement())
  number         String?       @unique // INV-00001
  subscriptionId Int
  customerId     Int
  discountId     Int?
  status         InvoiceStatus @default(DRAFT)
  invoiceDate    DateTime      @default(now())
  dueDate        DateTime
  periodStart    DateTime
  periodEnd      DateTime
  subtotal       Decimal       @db.Decimal(12, 2)
  discountTotal  Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  sentAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subscription Subscription  @relation(fields: [subscriptionId], references: [id])
  customer     User          @relation(fields: [customerId], references: [id])
  discount     Discount?     @relation(fields: [discountId], references: [id])
  lines        InvoiceLine[]
  payments     Payment[]

  @@unique([subscriptionId, periodStart]) // a period can never be billed twice
  @@index([status, dueDate])
  @@index([customerId])
  @@index([invoiceDate])
}

model InvoiceLine {
  id             Int     @id @default(autoincrement())
  invoiceId      Int
  productId      Int?
  description    String
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  amount         Decimal @db.Decimal(12, 2) // after discount, before tax

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
}

model Payment {
  id          Int           @id @default(autoincrement())
  invoiceId   Int
  method      PaymentMethod
  amount      Decimal       @db.Decimal(12, 2)
  paymentDate DateTime      @default(now())
  note        String?
  createdById Int?
  createdAt   DateTime      @default(now())

  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@index([paymentDate])
  @@index([invoiceId])
}

model BillingRun {
  id         Int       @id @default(autoincrement())
  trigger    String // "CRON" | "MANUAL"
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  created    Int       @default(0)
  skipped    Int       @default(0)
  failed     Int       @default(0)
  log        String?
}
